# =============================================================================
# Frontend environment (copy to .env — auto-created from this file on dev/build)
# Pipeline: set these as CI/CD secrets/variables to override per environment.
# =============================================================================

# --- App identity (Next.js renderer & Electron runtime; packaging uses electron-builder.yml) ---
NEXT_PUBLIC_APP_NAME=Cloud Travel Guide
NEXT_PUBLIC_APP_DESCRIPTION=智能旅行规划与导览桌面应用
NEXT_PUBLIC_APP_ID=com.cloudtravelguide.app
NEXT_PUBLIC_APP_PROTOCOL=cloud-travel-guide
# Must match backend DESKTOP_OAUTH_REDIRECT_URI
NEXT_PUBLIC_DESKTOP_OAUTH_REDIRECT_URI=cloud-travel-guide://auth/callback

# --- API (must align with backend CORS_ORIGINS / OAUTH_REDIRECT_ORIGINS) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Optional third-party keys ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Dev only: Electron loads Next.js from this URL (npm run dev) ---
ELECTRON_DEV_SERVER_URL=http://127.0.0.1:3000
