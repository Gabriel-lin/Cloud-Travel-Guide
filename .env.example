# Cross-platform Docker Compose defaults (safe to commit as .env.example → copy to .env)
COMPOSE_MENU=0

# Dev host ports
API_HOST_PORT=8000
POSTGRES_HOST_PORT=15432

# Shared DB (dev defaults; override for prod)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=cloud_travel_guide

# Sandbox runtime: runc works on Windows / macOS / Ubuntu.
# Only set runsc on Linux hosts with gVisor installed.
SANDBOX_RUNTIME=runc
