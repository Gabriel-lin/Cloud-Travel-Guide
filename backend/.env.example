# Copy to .env for local development (do not commit .env)

# Database
DATABASE_URL=postgresql://user:password@localhost:15432/cloud_travel_guide

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false

# Password transport — RSA private key PEM (required when ENVIRONMENT=production)
# Generate locally:
#   cd backend && uv run python scripts/generate_password_rsa_key.py
# Paste the output line below, or use --format value for CI / GitHub Actions secrets.
# AUTH_PASSWORD_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_PASSWORD_ENVELOPE_TTL_SECONDS=60

# CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# OAuth
# Backend callback: {OAUTH_BACKEND_CALLBACK_BASE}/api/v1/auth/oauth/{provider}/callback
OAUTH_BACKEND_CALLBACK_BASE=http://127.0.0.1:8000
# Frontend redirect origins (comma-separated; align with frontend NEXT_PUBLIC_API_BASE_URL origin)
OAUTH_REDIRECT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Must match frontend NEXT_PUBLIC_DESKTOP_OAUTH_REDIRECT_URI
DESKTOP_OAUTH_REDIRECT_URI=cloud-travel-guide://auth/callback
DESKTOP_OAUTH_CODE_EXPIRE_SECONDS=120
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_PASSWORD_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
