# Copy to .env for local development (do not commit .env)

# Database
DATABASE_URL=postgresql://user:password@localhost:15432/cloud_travel_guide

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false

# Password transport — RSA private key PEM (required when ENVIRONMENT=production)
# Generate locally:
#   cd backend && uv run python scripts/generate_password_rsa_key.py
# Paste the output line below, or use --format value for CI / GitHub Actions secrets.
# AUTH_PASSWORD_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_PASSWORD_ENVELOPE_TTL_SECONDS=60

# CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# OAuth
# Backend callback: {OAUTH_BACKEND_CALLBACK_BASE}/api/v1/auth/oauth/{provider}/callback
OAUTH_BACKEND_CALLBACK_BASE=http://127.0.0.1:8000
# Frontend redirect origins (comma-separated; align with frontend NEXT_PUBLIC_API_BASE_URL origin)
OAUTH_REDIRECT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Must match frontend NEXT_PUBLIC_DESKTOP_OAUTH_REDIRECT_URI
DESKTOP_OAUTH_REDIRECT_URI=cloud-travel-guide://auth/callback
DESKTOP_OAUTH_CODE_EXPIRE_SECONDS=120
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_PASSWORD_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# LLM multi-model (LiteLLM). Configure dedicated keys OR one OpenAI-compat gateway.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Third-party OpenAI-compatible gateway (one base_url + key → many models)
LLM_OPENAI_COMPAT_BASE_URL=
LLM_OPENAI_COMPAT_API_KEY=

# Logical default alias: gpt-5.5 | opus-4.8 | deepseek-v4-pro
# If unset / not configured, auto-picks by available keys:
#   OPENAI_API_KEY + OPENAI_API_BASE  → gpt-5.5
#   ANTHROPIC_API_KEY                 → opus-4.8
#   DEEPSEEK_API_KEY + DEEPSEEK_API_BASE → deepseek-v4-pro
LLM_DEFAULT_MODEL=gpt-5.5
# Optional JSON remap of aliases → LiteLLM model strings
# LLM_MODEL_ALIASES={"gpt-5.5":"openai/gpt-5.5","opus-4.8":"anthropic/claude-opus-4-8","deepseek-v4-pro":"openai/deepseek-v4-pro"}

# When no keys are set, stream a local mock reply (dev-friendly)
LLM_ALLOW_MOCK=true

# -----------------------------------------------------------------------------
# Agents — workspace + pluggable web search
# -----------------------------------------------------------------------------
# Sandboxed file tools root (relative to backend/ or absolute)
AGENT_WORKSPACE_DIR=.agent_workspace
# auto = Tavily when TAVILY_API_KEY is set, else DuckDuckGo
AGENT_SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Document export (Markdown → PDF via convert_markdown_to_pdf)
# -----------------------------------------------------------------------------
# Pre-render ```mermaid``` blocks to PNG via mermaid.ink (requires outbound HTTPS).
DOCUMENT_MERMAID_RENDER=true
MERMAID_INK_BASE_URL=https://mermaid.ink/img
DOCUMENT_MERMAID_TIMEOUT_SEC=20

# -----------------------------------------------------------------------------
# Sandbox worker (Docker / gVisor) — only the sandbox-worker service needs these
# -----------------------------------------------------------------------------
# runc = default (dev / Windows Docker Desktop). runsc = gVisor on Linux prod hosts.
SANDBOX_RUNTIME=runc
SANDBOX_PYTHON_IMAGE=cloud-travel-guide-sandbox-python:3.12
SANDBOX_BASH_IMAGE=cloud-travel-guide-sandbox-python:3.12
SANDBOX_PLAYWRIGHT_IMAGE=cloud-travel-guide-sandbox-playwright:3.12
SANDBOX_PLAYWRIGHT_MEMORY_LIMIT=1g
SANDBOX_PLAYWRIGHT_SHM_SIZE=256m
SANDBOX_JOB_TIMEOUT_SEC=600
SANDBOX_TOOL_WAIT_SEC=600
SANDBOX_MAX_CONCURRENT_JOBS_PER_USER=2
SANDBOX_ALLOW_NETWORK=false
# Worker lease: reclaim stuck "running" jobs after lease expiry
SANDBOX_JOB_LEASE_SEC=60
SANDBOX_JOB_HEARTBEAT_SEC=15
# Compose sets this automatically (ctg_agent_workspace). Set only for non-compose workers.
# SANDBOX_WORKSPACE_VOLUME=ctg_agent_workspace
