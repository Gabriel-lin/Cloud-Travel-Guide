# Playwright + Chromium — optional sandbox for pixel-accurate HTML/PDF rendering.
FROM python:3.12-slim-bookworm

ENV MPLCONFIGDIR=/tmp/matplotlib \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    PYTHONPATH=/opt/ctg-sandbox/tools

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
        libjpeg62-turbo libopenjp2-7 libffi8 \
        fonts-noto-cjk fonts-noto-cjk-extra \
        fontconfig \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /uvx /bin/

WORKDIR /build
COPY sandbox/pyproject.toml sandbox/uv.lock ./

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/usr/local

RUN uv sync --frozen --no-dev --no-install-project --group playwright \
    && mkdir -p /opt/ms-playwright \
    && uv run playwright install --with-deps chromium \
    && chmod -R a+rX /opt/ms-playwright

COPY sandbox/tools /opt/ctg-sandbox/tools
RUN chmod -R a+rX /opt/ctg-sandbox

USER 65534:65534
WORKDIR /agent_workspace
